# Copie para .env e preencha o que tiver. Nenhuma chave é obrigatória:
# lojas sem chave aparecem como "precisa de chave" e a busca continua nas outras.

# --- Mercado Livre (API oficial) ---
# Crie um app em https://developers.mercadolivre.com.br/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# --- Amazon Creators API ---
# Requer conta no Associados (https://associados.amazon.com.br) com vendas qualificadas
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com.br

# --- Shopee Afiliados ---
# Requer aprovação em https://affiliate.shopee.com.br (App ID e Secret no painel Open API)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# --- Geral ---
# Banco: SQLite local por padrão. No Docker Compose o PostgreSQL é configurado automaticamente.
# DATABASE_URL=postgresql+psycopg://promo:promo@localhost:5432/promo
# Supabase (Session pooler; senha com caracteres especiais precisa ser codificada, ex.: @ -> %40):
# DATABASE_URL=postgresql+psycopg://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
CACHE_TTL_MINUTES=30
STORE_TIMEOUT_SECONDS=25
REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=4.0
# Lojas ativas (vazio = todas). Ex.: ENABLED_STORES=kabum,mercadolivre
ENABLED_STORES=
LOG_LEVEL=INFO
